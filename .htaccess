Options -Indexes
RewriteEngine On

# Allow the clean /admin URL to be handled by the rewrite rule below even
# though "admin" is also a physical directory.
DirectorySlash Off

# Canonicalise PHP pages so trailing slashes do not break relative assets.
RewriteCond %{REQUEST_URI} ^(.+\.php)/$
RewriteRule ^(.+\.php)/$ /rihla/$1 [R=301,L,NE]

# مسارات الواجهات النظيفة.
# يفتح المسار المختصر لوحة المؤشرات داخل طبقة الإدارة المحمية مباشرةً.
RewriteRule ^admin/?$ admin/admin.php [QSA,L]

# تمرير جميع طلبات الواجهة البرمجية إلى الموجّه المركزي.
RewriteCond %{REQUEST_URI} /rihla_app/api/v1/index\.php$
RewriteCond %{QUERY_STRING} ^$
RewriteRule ^api/v1/index\.php$ api/v1/index.php?route=health [END]
RewriteRule ^api/v1/?$ api/v1/index.php [QSA,L]
RewriteRule ^api/v1/(.*)$ api/v1/index.php?route=$1 [QSA,L]

# إخفاء الملفات الحساسة والملفات المصدرية غير المخصصة للعرض.
<FilesMatch "\.(env|sql|md|log|test)$">
  Require all denied
</FilesMatch>
