function fmtBytes($b, $p = 2) {
    if (!$b) return '0 B';
    $u = ['B','KB','MB','GB','TB'];
    $i = floor(log($b, 1024));
    return round($b / (1 << (10 * $i)), $p) . ' ' . $u[min($i,4)];
}
