                    <?php
                    $free = (int)($stats['disk_free_bytes'] ?? 0);
                    $total = (int)($stats['disk_total_bytes'] ?? 0);
                    if ($total > 0):
                        $used = $total - $free;
                        $pct = round(($used / $total) * 100, 1);
                        $color = $pct > 90 ? 'danger' : ($pct > 75 ? 'warning' : 'success');
                    ?>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="fw-semibold">المستخدمة: <?= fmtBytes($used) ?></span>
                                <span class="text-muted"><?= fmtBytes($free) ?> متبقية من <?= fmtBytes($total) ?></span>
                            </div>
                            <div class="progress" style="height:20px;">
                                <div class="progress-bar bg-<?= $color ?>" role="progressbar" style="width:<?= $pct ?>%" aria-valuenow="<?= $pct ?>" aria-valuemin="0" aria-valuemax="100"><?= $pct ?>%</div>
                            </div>
                        </div>
                    <?php else: ?>
                        <div class="text-center py-3 text-muted">تعذر قراءة معلومات القرص.</div>
